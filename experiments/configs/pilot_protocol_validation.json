{
  "purpose": "pilot_protocol_validation_only",
  "datasets": ["email-Eu-core", "ego-Facebook", "Wiki-Vote"],
  "rumor_seed_count": 1,
  "k": 5,
  "propagation_probabilities": [0.01, 0.05],
  "tie_breaking": "protector-priority",
  "S_opt": 20,
  "S_eval": 200,
  "independent_runs": 3,
  "random_seed": 2026,
  "seed_block_size": 1000000,
  "ga_parameters": {
    "population_size": 10, "max_generations": 10,
    "crossover_rate": 0.8, "mutation_rate": 0.1,
    "tournament_size": 3, "elitism_count": 1, "cache_fitness": true
  },
  "pagerank_parameters": {"alpha": 0.85, "tol": 1e-12, "max_iter": 1000},
  "candidate_pool_size": 10,
  "limits": {
    "max_optimization_evaluations": 100,
    "max_optimization_cic_simulations": 2000,
    "max_full_greedy_evaluations": 100,
    "max_full_greedy_cic_simulations": 2000
  },
  "resources": {
    "max_total_wall_seconds": 1200,
    "max_comparison_wall_seconds": 300,
    "runtime_safety_factor": 2.0
  },
  "smoke": {
    "p": 0.05, "S_opt": 2, "S_eval": 5,
    "ga_parameters": {
      "population_size": 4, "max_generations": 1,
      "crossover_rate": 0.8, "mutation_rate": 0.1,
      "tournament_size": 2, "elitism_count": 1, "cache_fitness": true
    }
  },
  "diagnostics": {
    "low_spread_fraction": 0.01,
    "saturation_fraction": 0.9,
    "target_opt_se_fraction": 0.01,
    "target_eval_se_fraction": 0.005,
    "precision_prefixes": [20, 50, 100, 200]
  },
  "save_raw_observations": true,
  "output_directory": "../../results/pilot_protocol_validation"
}
